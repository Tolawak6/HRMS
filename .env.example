# -----------------------------------------------------------------------------
# ESS HRMS environment configuration
# Copy this file to .env and fill in values for your installation.
# Never commit .env to version control.
# -----------------------------------------------------------------------------

# Application
APP_NAME="ESS HRMS"
APP_ENV=production
APP_DEBUG=false
# Set the public URL only when the app is served from a different host/prefix.
APP_URL=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrms
# Create a dedicated MySQL user instead of using root in production.
DB_USERNAME=hrms_app
DB_PASSWORD=change-me
# Optional: use a Unix socket instead of host/port
DB_SOCKET=

# Session and security
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
PASSWORD_MIN_LENGTH=10
# Trust X-Forwarded-For only when the app is behind a trusted reverse proxy.
TRUST_PROXY=false

# File storage (must be outside the public web root in production if possible)
STORAGE_PATH=

# Timezone used for display and storage
APP_TIMEZONE=Africa/Addis_Ababa
